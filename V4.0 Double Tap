local Enabled = false
local LastTap = 0

-- [SYSTEM: DOUBLE TAP TO TOGGLE]
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local CurrentTime = tick()
        if (CurrentTime - LastTap) < 0.3 then -- แตะ 2 ครั้งภายใน 0.3 วินาที
            Enabled = not Enabled
            -- แจ้งเตือนสั้นๆ ใน Console (ไม่มีหน้าต่างโปรเด้ง)
            print("V4.0 Status: " .. (Enabled and "ON" or "OFF"))
        end
        LastTap = CurrentTime
    end
end)

