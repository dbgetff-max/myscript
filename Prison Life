local FLY_SPEED = 50
local FIRE_RATE = 0.12
local SilentAimEnabled = true
local FlyEnabled = false
local AutoShootEnabled = false
local ESPEnabled = true

-- Silent Aim
local function getClosestPlayer()
    local closest, shortest = nil, 9999
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr \~= player and plr.Character and plr.Character:FindFirstChild("Head") then
            local dist = (plr.Character.Head.Position - root.Position).Magnitude
            if dist < shortest then
                shortest = dist
                closest = plr
            end
        end
    end
    return closest
end

local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if SilentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
        if self.Name:find("Shoot") or self.Name:find("Fire") or self.Name:find("Bullet") then
            local target = getClosestPlayer()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                args[1] = target.Character.Head.Position
            end
        end
    end
    return old(self, unpack(args))
end)
setreadonly(mt, true)

-- Fly System
local BodyVelocity, BodyGyro
local function toggleFly()
    FlyEnabled = not FlyEnabled
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if FlyEnabled then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(1e5,1e5,1e5)
        BodyVelocity.Parent = root
        
        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5)
        BodyGyro.Parent = root
        
        print("🛫 Fly เปิดแล้ว")
    else
        if BodyVelocity then BodyVelocity:Destroy() end
        if BodyGyro then BodyGyro:Destroy() end
        print("🛫 Fly ปิดแล้ว")
    end
end

RunService.Heartbeat:Connect(function()
    if FlyEnabled and BodyVelocity then
        local cam = workspace.CurrentCamera
        local dir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
        
        BodyVelocity.Velocity = dir.Unit * FLY_SPEED
        if BodyGyro then BodyGyro.CFrame = cam.CFrame end
    end
end)

-- Auto Shoot
spawn(function()
    while wait(FIRE_RATE) do
        if AutoShootEnabled then
            local target = getClosestPlayer()
            if target then
                for _, tool in ipairs(player.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        tool:Activate()
                    end
                end
            end
        end
    end
end)

-- ESP
local function createESP(plr)
    if plr == player then return end
    local char = plr.Character or plr.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    local bg = Instance.new("BillboardGui")
    bg.Adornee = root
    bg.AlwaysOnTop = true
    bg.Size = UDim2.new(0, 200, 0, 60)
    bg.StudsOffset = Vector3.new(0,3,0)
    bg.Parent = root

    local txt = Instance.new("TextLabel", bg)
    txt.Size = UDim2.new(1,0,1,0)
    txt.BackgroundTransparency = 1
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold
    txt.TextStrokeTransparency = 0.4

    RunService.RenderStepped:Connect(function()
        if not ESPEnabled then return end
        local team = plr.Team and plr.Team.Name or ""
        local dist = root.Position.Magnitude > 0 and math.floor((root.Position - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position or Vector3.new())).Magnitude) or 0
        
        if team:find("Guard") then
            txt.TextColor3 = Color3.fromRGB(0, 170, 255)
            txt.Text = plr.Name .. " [ตำรวจ]\n" .. dist .. "m"
        elseif team:find("Criminal") then
            txt.TextColor3 = Color3.fromRGB(255, 50, 50)
            txt.Text = plr.Name .. " [ผู้ก่อเหตุ]\n" .. dist .. "m"
        else
            txt.TextColor3 = Color3.fromRGB(255, 165, 0)
            txt.Text = plr.Name .. " [นักโทษ]\n" .. dist .. "m"
        end
    end)
end

-- โหลด ESP
for _, p in pairs(Players:GetPlayers()) do
    if p \~= player then createESP(p) end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() wait(1) createESP(p) end)
end)

