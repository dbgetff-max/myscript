createFOVButton()

-- Slider ปรับขนาดวง (ง่ายๆ)
local function createSlider()
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.9, 0, 0, 30)
    label.Position = UDim2.new(0.05, 0, 0, 180)
    label.Text = "ขนาดวง: " .. fovRadius
    label.TextColor3 = Color3.new(1,1,1)
    label.Parent = mainFrame

    -- ปุ่ม + -
    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0.2, 0, 0, 40)
    minus.Position = UDim2.new(0.05, 0, 0, 210)
    minus.Text = "-"
    minus.BackgroundColor3 = Color3.fromRGB(100,0,0)
    minus.Parent = mainFrame
    minus.MouseButton1Click:Connect(function()
        fovRadius = math.max(50, fovRadius - 20)
        label.Text = "ขนาดวง: " .. fovRadius
    end)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0.2, 0, 0, 40)
    plus.Position = UDim2.new(0.75, 0, 0, 210)
    plus.Text = "+"
    plus.BackgroundColor3 = Color3.fromRGB(0,100,0)
    plus.Parent = mainFrame
    plus.MouseButton1Click:Connect(function()
        fovRadius = math.min(400, fovRadius + 20)
        label.Text = "ขนาดวง: " .. fovRadius
    end)
end

createSlider()

